<div class="TyagGW_tableContainer"><div tabindex="-1" class="group TyagGW_tableWrapper flex flex-col-reverse w-fit"><table data-start="485" data-end="615" class="w-fit min-w-(--thread-content-width)"><thead data-start="485" data-end="496"><tr data-start="485" data-end="496"><th data-start="485" data-end="490" data-col-size="sm" class="last:pe-10">英語</th><th data-start="490" data-end="496" data-col-size="sm" class="last:pe-10">意味</th></tr></thead><tbody data-start="507" data-end="615"><tr data-start="507" data-end="528"><td data-start="507" data-end="520" data-col-size="sm">Repository</td><td data-col-size="sm" data-start="520" data-end="528">保存場所</td></tr><tr data-start="529" data-end="546"><td data-start="529" data-end="538" data-col-size="sm">Commit</td><td data-col-size="sm" data-start="538" data-end="546">保存記録</td></tr><tr data-start="547" data-end="567"><td data-start="547" data-end="554" data-col-size="sm">Push</td><td data-col-size="sm" data-start="554" data-end="567">GitHubへ送る</td></tr><tr data-start="568" data-end="581"><td data-start="568" data-end="575" data-col-size="sm">Pull</td><td data-col-size="sm" data-start="575" data-end="581">取得</td></tr><tr data-start="582" data-end="597"><td data-start="582" data-end="591" data-col-size="sm">Branch</td><td data-col-size="sm" data-start="591" data-end="597">分岐</td></tr><tr data-start="598" data-end="615"><td data-start="598" data-end="605" data-col-size="sm">Main</td><td data-col-size="sm" data-start="605" data-end="615">メインデータ</td></tr></tbody></table><div class="relative h-0 self-end select-none"><div class="absolute end-0 flex items-end" style="height: 33px;"><span class="" data-state="closed"><button aria-label="表をコピーする" class="hover:bg-token-bg-tertiary text-token-text-secondary relative z-10 my-1 rounded-sm p-1 transition-opacity group-[:not(:hover):not(:focus-within)]:pointer-events-none group-[:not(:hover):not(:focus-within)]:opacity-0"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-